{
  "name": "chrome-bookmark-list",
  "version": "4.2.0",
  "description": "Chrome extension for displaying bookmarks in a folder-based list with history search",
  "scripts": {
    "build": "tsc",
    "build:extension": "./build.sh",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/chrome": "^0.1.43",
    "@types/jsdom": "^21.1.7",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "happy-dom": "^20.14.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "private": true
}
