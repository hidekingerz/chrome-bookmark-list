{
  "manifest_version": 3,
  "name": "Chrome Bookmark List",
  "version": "4.3.1",
  "minimum_chrome_version": "156",
  "description": "新しいタブにブックマークをフォルダ別に表示し、編集や並べ替えもできる。履歴の検索と、最近閉じたタブの復元にも対応",
  "permissions": [
    "bookmarks",
    "history",
    "tabGroups",
    "favicon",
    "sessions",
    "tabs"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
